{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/tree-sitter.schema.json",
  "grammars": [
    {
      "name": "verbose",
      "camelcase": "Verbose",
      "scope": "source.verbose",
      "file-types": ["vb"],
      "injection-regex": "^verbose$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for VerBose-Lang",
    "authors": [
      {
        "name": "thetrung"
      }
    ]
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
